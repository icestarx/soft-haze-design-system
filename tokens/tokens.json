        "border": "#dce8e8", "border-strong": "#c4d9dc", "brand": "#448da5",
        "brand-strong": "#28677e", "brand-soft": "#e5f3f8", "accent-warm": "#d99170",
        "accent-warm-soft": "#fff0e7", "accent-cool": "#5c9c84", "accent-cool-soft": "#e3f2e9",
