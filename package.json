{
  "name": "soft-haze-design-system",
  "version": "0.1.0",
  "type": "module",
  "description": "柔雾霞光：可换色的 React 设计系统与预览",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "check": "tsc -p tsconfig.json --noEmit",
    "tokens:build": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/check-theme-contrast.mjs",
    "consumer:pack": "bun run build && bun pm pack --destination examples/consumer-app",
    "build": "node scripts/build-tokens.mjs && node scripts/check-theme-contrast.mjs && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.build.json && vite build && vite build --config vite.lib.config.ts",
    "preview": "vite preview --host 0.0.0.0"
  },
  "main": "./dist/lib/soft-haze.js",
  "module": "./dist/lib/soft-haze.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/lib/soft-haze.js"
    },
    "./styles.css": "./dist/lib/styles.css",
    "./tokens/*": "./tokens/*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.0.0",
    "typescript": "~5.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "files": ["dist/lib", "dist/types", "tokens", "README.md", "LICENSE"]
}
