{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Soft Haze Design System",
  "version": "0.1.0",
  "shared": {
    "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px", "10": "40px", "12": "48px" },
    "radius": { "control": "12px", "card": "18px", "panel": "26px", "pill": "999px" },
    "font": { "family": "Inter, \"SF Pro Display\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif", "size-xs": "12px", "size-sm": "14px", "size-md": "16px", "size-lg": "20px", "size-xl": "28px" },
